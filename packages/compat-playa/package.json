{
  "name": "@playa/player",
  "version": "0.6.0",
  "description": "Compatibility re-export of @openmoq/playa. Use @openmoq/playa for new integrations.",
  "license": "Apache-2.0",
  "author": "OpenMOQ (https://github.com/openmoq)",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./browser": {
      "types": "./browser.d.ts",
      "import": "./browser.js",
      "default": "./browser.js"
    }
  },
  "files": [
    "*.js",
    "*.d.ts"
  ],
  "dependencies": {
    "@openmoq/playa": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmoq/moq-playa.git",
    "directory": "packages/compat-playa"
  },
  "publishConfig": {
    "access": "public"
  }
}
