{
  "name": "@moqt/quic",
  "version": "0.6.0",
  "description": "Compatibility re-export of @openmoq/quic. Use @openmoq/quic for new integrations.",
  "license": "Apache-2.0",
  "author": "OpenMOQ (https://github.com/openmoq)",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "*.js",
    "*.d.ts"
  ],
  "dependencies": {
    "@openmoq/quic": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmoq/moq-playa.git",
    "directory": "packages/compat-quic"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.8.1"
  }
}
