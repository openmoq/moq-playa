{
  // Typecheck gate for test and test-support code.
  //
  // The package tsconfigs deliberately compile only `src/**/*.ts` minus tests,
  // because that is what ships in `dist`. The consequence is that simulation
  // suites and `test-support/` helpers were never typechecked at all, allowing
  // missing interface fields to survive package-level typechecks.
  // Vitest transpiles without typechecking, so this project is the only gate.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  // Scoped to simulation suites, test-support helpers, repository scripts,
  // and draft-22 conformance tests. The wider
  // `*.test.ts` corpus predates any typecheck gate and does not compile clean
  // under these options; widening this include is a separate cleanup.
  "include": [
    "packages/*/src/**/*.sim.test.ts",
    "packages/*/test-support/**/*.ts",
    "packages/transport/src/session/session-d22-conformance.test.ts",
    "packages/webtransport/src/adapter-d22-conformance.test.ts",
    "packages/webtransport/src/adapter-d22-lifecycle.test.ts",
    "packages/webtransport/src/topology/inbound-request.test.ts",
    "packages/player/src/player-d22-bootstrap.loopback.test.ts",
    "packages/webtransport/src/adapter-goaway-notice.test.ts",
    "packages/webtransport/src/adapter-goaway-diagnostics.test.ts",
    "packages/player/src/player-goaway-request-owners.test.ts",
    "packages/player/src/player-goaway-catalog-retirement.test.ts",
    "packages/player/src/player-goaway-owner-isolation.test.ts",
    "packages/player/src/player-goaway-inflight-fallback.test.ts",
    "packages/player/src/player-goaway-scope.loopback.test.ts",
    "packages/player/src/player-graceful-handover.loopback.test.ts",
    "packages/player/src/player-handover-selection.test.ts",
    "packages/player/src/player-track-namespace.loopback.test.ts",
    "packages/player/src/player-locmaf-namespace.loopback.test.ts",
    "packages/player/src/catalog-selection.test.ts",
    "packages/player/src/selection-composition.test.ts",
    "packages/player/src/configured-selection.test.ts",
    "packages/playa/src/quality.test.ts",
    "packages/player/src/catalog-namespace-provenance.test.ts",
    "packages/browser/src/cmaf-assembler-handover.test.ts",
    "packages/msf/src/video-alt-group.test.ts",
    "packages/player/src/player-video-alt-group.test.ts",
    "scripts/**/*.test.ts",
    "_migration/**/*.test.ts"
  ]
}
